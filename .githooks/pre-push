#!/usr/bin/env bash
# Runs the full checks before anything leaves the machine and protects main from force-pushes.
# Skip the checks with SKIP_PREPUSH_CHECKS=1; allow a force-push with ALLOW_FORCE_PUSH=1.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

input=$(cat)
printf '%s\n' "$input" | run_global_hook pre-push "$@"

zero=0000000000000000000000000000000000000000
needs_checks=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  if [ "$local_sha" = "$zero" ]; then
    [ "$remote_ref" != refs/heads/main ] || [ "${ALLOW_FORCE_PUSH:-}" = 1 ] || fail "refusing to delete main (ALLOW_FORCE_PUSH=1 to override)"
    continue
  fi
  needs_checks=1
  if [ "$remote_ref" = refs/heads/main ] && [ "$remote_sha" != "$zero" ] &&
    ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    [ "${ALLOW_FORCE_PUSH:-}" = 1 ] || fail "refusing a non-fast-forward push to main; fetch first (ALLOW_FORCE_PUSH=1 to override)"
  fi
done <<<"$input"

[ "$needs_checks" = 1 ] || exit 0
if [ "${SKIP_PREPUSH_CHECKS:-}" = 1 ]; then
  echo "pre-push: skipping checks"
  exit 0
fi
scripts/check.sh
