# Local development.
# `shopify app dev` supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES itself.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/sftp_export"

# 32 random bytes as 64 hex characters: openssl rand -hex 32
# Use a different key for every environment; losing it makes stored SFTP credentials unreadable.
ENCRYPTION_KEY=
# Set to the old key while rotating ENCRYPTION_KEY, so existing data stays readable until re-saved.
# ENCRYPTION_KEY_PREVIOUS=

# Development only: lets the app connect to localhost / private SFTP hosts. Never set in production.
ALLOW_PRIVATE_SFTP_HOSTS=true

# Production (set in the host's dashboard, not in a file):
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL,
# LEGAL_ENTITY_NAME, SUPPORT_EMAIL, HOSTING_REGION, GOVERNING_LAW (shown on /privacy and /terms)
# SCOPES=read_orders
