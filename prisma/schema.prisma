// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantConfig {
  id                      String   @id @default(cuid())
  shop                    String   @unique
  sftpHost                String
  sftpPort                Int      @default(22)
  sftpUsername            String
  authMethod              String   @default("password")
  sftpPasswordEncrypted   String?
  sftpIv                  String?
  sftpPrivateKeyEncrypted String?
  sftpKeyIv               String?
  targetDirectory         String   @default("/upload")
  filenameTemplate        String   @default("order-{order}.csv")
  csvColumns              String?
  sftpHostKey             String?
  exportTrigger           String   @default("created")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ExportJob {
  id               String   @id
  shop             String
  orderId          String
  orderName        String
  status           String
  attempts         Int      @default(0)
  nextAttemptAt    DateTime
  lastError        String?
  payloadEncrypted String?
  payloadIv        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, orderId])
  @@index([status, nextAttemptAt])
  @@index([shop, createdAt])
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
